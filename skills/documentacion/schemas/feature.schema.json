{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature presentation candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "context", "scope", "flow", "stories", "comparison", "plan", "clarification"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "service", "role", "status", "version", "date"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "subtitle": { "type": "string", "minLength": 3 },
        "service": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "status": { "type": "string", "enum": ["Propuesta", "En implementación", "Completada"] },
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "author": { "type": "string", "minLength": 1 },
        "brandColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "objective", "plain"],
      "properties": {
        "summary": { "type": "string", "minLength": 20 },
        "objective": { "type": "string", "minLength": 10 },
        "plain": { "type": "string", "minLength": 20 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out", "pending"],
      "properties": {
        "in": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
        "out": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
        "pending": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "detail"],
            "properties": {
              "title": { "type": "string", "minLength": 3 },
              "detail": { "type": "string", "minLength": 5 }
            }
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "as", "want", "so"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "as": { "type": "string", "minLength": 2 },
          "want": { "type": "string", "minLength": 5 },
          "so": { "type": "string", "minLength": 5 }
        }
      }
    },
    "techImpact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path"],
            "properties": {
              "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
              "path": { "type": "string", "minLength": 2 }
            }
          }
        },
        "tables": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
      }
    },
    "comparison": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["now", "next"],
        "properties": {
          "now": { "type": "string", "minLength": 5 },
          "next": { "type": "string", "minLength": 5 }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "steps", "calendar"],
      "properties": {
        "team": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "name"],
            "properties": {
              "role": { "type": "string", "minLength": 2 },
              "name": { "type": "string", "minLength": 2 }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "timeEstimate", "devTasks", "qaTasks"],
            "properties": {
              "title": { "type": "string", "minLength": 3 },
              "timeEstimate": { "type": "string", "minLength": 3 },
              "intro": { "type": "string", "minLength": 5 },
              "devTasks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["task", "role", "hours"],
                  "properties": {
                    "task": { "type": "string", "minLength": 5 },
                    "role": { "type": "string", "minLength": 2 },
                    "hours": { "type": "number", "minimum": 0.5 },
                    "flag": { "type": "string", "enum": ["pendiente", "datos de prueba"] }
                  }
                }
              },
              "qaTasks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["task", "hours"],
                  "properties": {
                    "task": { "type": "string", "minLength": 5 },
                    "hours": { "type": "number", "minimum": 0.5 },
                    "flag": { "type": "string", "enum": ["pendiente", "datos de prueba"] }
                  }
                }
              },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        },
        "calendar": { "type": "string", "minLength": 3 },
        "calendarNote": { "type": "string", "minLength": 5 }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "outOfScope"],
      "properties": {
        "pending": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
        "outOfScope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "items"],
            "properties": {
              "title": { "type": "string", "minLength": 3 },
              "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
              "detail": { "type": "string", "minLength": 5 }
            }
          }
        }
      }
    },
    "notes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } }
  }
}
